MAX_REQUEST_SIZE=1024
SCAN_PORTS=21,22,25,80,443,3306,3389,5432,6379,8080
ALLOW_PRIVATE_TARGETS=false
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# LLM (any OpenAI-compatible API). Leave LLM_BASE_URL or LLM_MODEL empty to disable AI analysis.
# Groq: get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=30

# Local Ollama instead (no key needed; run `ollama pull llama3.2` first):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2
